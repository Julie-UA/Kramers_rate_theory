import numpy as np
import matplotlib.pyplot as plt

# Load data files
data1 = np.loadtxt("pmf-c1-tmp.txt.xvg", comments=('#','@'))
data2 = np.loadtxt("pmf-c2-tmp.txt.xvg", comments=('#','@'))
data3 = np.loadtxt("pmf-c3-tmp.txt.xvg", comments=('#','@'))

# Extract columns
x1, y1 = data1[:,0], data1[:,1]
x2, y2 = data2[:,0], data2[:,1]
x3, y3 = data3[:,0], data3[:,1]

# Plot all three on the same figure
plt.figure(figsize=(8, 5), dpi=300)  

plt.plot(x1, y1, '-o', label="pmf-c1-tmp.txt.xvg")
plt.plot(x2, y2, '-s', label="pmf-c2-tmp.txt.xvg")
plt.plot(x3, y3, '-^', label="pmf-c3-tmp.txt.xvg")

plt.xlabel("distance Ligand COM - Active site COM (Å)")
plt.ylabel("PMF (kcal/mol)")
plt.title("PMF 1D LiGaMD Reweighted PMF")
plt.legend()
plt.tight_layout()

plt.savefig("PMF_reweight.png", dpi=300, bbox_inches="tight")

plt.show()
